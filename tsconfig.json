{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["core", "overlay", "client", "examples", "server", "agent", "donor", "swap", "web/src", "app/src"],
  // Code on the offline mock chain (demos, tests) loads the CJS SDK build: it is
  // type-checked by tsconfig.mock.json instead (npm run typecheck:mock).
  "exclude": ["server/demo.ts", "server/agentDemo.ts", "server/agentDemoMain.ts"]
}
