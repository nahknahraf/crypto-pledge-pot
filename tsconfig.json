{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["core", "overlay", "client", "examples", "server", "agent", "web/src", "app/src"],
  // Like test/, the demo runs on the mock chain helper (CJS SDK build): run under vite-node, not type-checked here.
  "exclude": ["server/demo.ts"]
}
