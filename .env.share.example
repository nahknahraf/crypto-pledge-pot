# Copy to .env.share (git-ignored) and fill in. Used by: npm run share:internet
# Your free static domain from the ngrok dashboard → Domains (without https://)
NGROK_DOMAIN=your-name.ngrok-free.app
# main = real mainnet (testers use their BSV Desktop wallets) · demo = offline demo (wallets disabled)
SHARE_MODE=main
# Also run the AI agent and its paid data API (needs ~3,000 sats fee float; top it up from its campaign page)
WITH_AGENT=yes
# Optional: Claude for the agent's decisions (otherwise a deterministic mock brain)
# ANTHROPIC_API_KEY=
