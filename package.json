{
  "name": "crypto-pledge-pot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CryptoPledgePot: trustless milestone crowdfunding on BSV (sCrypt escrow + BRC-100 wallets). Includes the BSV-21 token kit it was built from.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "overlay": "tsx overlay/server.ts",
    "web": "vite web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "vite-node --config vitest.config.ts server/main.ts",
    "app": "vite app",
    "app:build": "vite build app",
    "contracts:compile": "cd contracts && npm install && npm run compile",
    "contracts:crosscheck": "cd contracts && npm run build && npm run crosscheck",
    "demo": "vite-node --config vitest.config.ts server/demo.ts",
    "agent": "vite-node --config vitest.config.ts agent/main.ts --",
    "data-provider": "vite-node --config vitest.config.ts agent/providerMain.ts",
    "import": "vite-node --config vitest.config.ts server/importTx.ts --",
    "share": "vite build app && vite preview app",
    "share:internet": "bash scripts/share.sh",
    "demo:agent": "vite-node --config vitest.config.ts server/agentDemoMain.ts",
    "typecheck:mock": "tsc --noEmit -p tsconfig.mock.json",
    "donor": "vite-node --config vitest.config.ts donor/main.ts",
    "routine-agent": "vite-node --config vitest.config.ts agent/routineAgentMain.ts",
    "demo:swap": "vite-node --config vitest.config.ts swap/swapDemoMain.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bsv/402-pay": "^0.3.3",
    "@bsv/auth-express-middleware": "^2.2.9",
    "@bsv/overlay": "^2.6.4",
    "@bsv/overlay-express": "^2.7.4",
    "@bsv/payment-express-middleware": "^2.1.9",
    "@bsv/sdk": "^3.2.1",
    "@bsv/wallet-toolbox": "^2.14.9",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "author": "",
  "license": "ISC"
}
