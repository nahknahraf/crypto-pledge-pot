{
  "name": "crypto-pledge-pot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CryptoPledgePot: trustless milestone crowdfunding on BSV (sCrypt escrow + BRC-100 wallets). Includes the BSV-21 token kit it was built from.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "overlay": "tsx overlay/server.ts",
    "web": "vite web",
    "test": "vitest run",
    "test:happy": "vitest run test/happyPaths.e2e.test.ts test/cryptoPledgePot.e2e.test.ts test/agentDemo.e2e.test.ts test/swapDemo.test.ts test/bridge.evm.test.ts test/bridge.service.test.ts test/bridge.browser.test.ts test/bridge.dex.test.ts test/bridge.btc.test.ts test/bridge.lightning.test.ts test/receive.test.ts test/payments-nft.e2e.test.ts test/pay-per-request.e2e.test.ts test/recovery.e2e.test.ts test/e2e.mockchain.test.ts",
    "typecheck": "tsc --noEmit",
    "server": "vite-node --config vitest.config.ts server/main.ts",
    "app": "vite app",
    "app:build": "vite build app",
    "contracts:compile": "cd contracts && npm install && npm run compile",
    "contracts:crosscheck": "cd contracts && npm run build && npm run crosscheck",
    "demo": "vite-node --config vitest.config.ts server/demo.ts",
    "agent": "vite-node --config vitest.config.ts fundraising-agent/main.ts --",
    "data-provider": "vite-node --config vitest.config.ts data-provider/main.ts",
    "import": "vite-node --config vitest.config.ts server/importTx.ts --",
    "share": "vite build app && vite preview app",
    "share:internet": "bash scripts/share.sh",
    "demo:agent": "vite-node --config vitest.config.ts server/agentDemoMain.ts",
    "typecheck:mock": "tsc --noEmit -p tsconfig.mock.json",
    "donor": "vite-node --config vitest.config.ts donor-agent/main.ts",
    "demo:swap": "vite-node --config vitest.config.ts liquidity-agent/swapDemoMain.ts",
    "demo:donor": "vite-node --config vitest.config.ts donor-agent/donorDemoMain.ts",
    "demo:bridge": "vite-node --config vitest.config.ts liquidity-agent/bridgeDemoMain.ts",
    "evm:compile": "node evm/compile.cjs",
    "lp": "vite-node --config vitest.config.ts liquidity-agent/lpMain.ts",
    "eval:agents": "vite-node --config vitest.config.ts eval/agentEvalMain.ts",
    "evm:deploy": "vite-node --config vitest.config.ts liquidity-agent/evmDeployMain.ts",
    "secrets:init": "vite-node --config vitest.config.ts scripts/secretsInit.ts",
    "demo:bridge:btc": "vite-node --config vitest.config.ts liquidity-agent/btcBridgeDemoMain.ts",
    "demo:bridge:ln": "vite-node --config vitest.config.ts liquidity-agent/lnBridgeDemoMain.ts",
    "keys:new": "vite-node --config vitest.config.ts scripts/keysNew.ts",
    "lp:fund": "vite-node --config vitest.config.ts scripts/lpFund.ts",
    "preflight": "vite-node --config vitest.config.ts scripts/preflight.ts",
    "eval:agents:cli": "AGENT_BRAIN=claude-cli DONOR_BRAIN=claude-cli vite-node --config vitest.config.ts eval/agentEvalMain.ts",
    "rehearse:agents": "vite-node --config vitest.config.ts server/rehearsalMain.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bsv/402-pay": "^0.3.3",
    "@bsv/auth-express-middleware": "^2.2.9",
    "@bsv/overlay": "^2.6.4",
    "@bsv/overlay-express": "^2.7.4",
    "@bsv/payment-express-middleware": "^2.1.9",
    "@bsv/sdk": "^3.2.1",
    "@bsv/wallet-toolbox": "^2.14.9",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "solc": "^0.8.38",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "author": "",
  "license": "ISC"
}
