
contract CryptoPledgePotEscrow {
  bytes campaignId;
  PubKey creator;
  PubKey arbiter;
  PubKey donor;
  int pledged;
  int[4] cumulativeBps;
  int refundAfter;
  bytes __scrypt_ts_ctx_hashoutputs;
  int __scrypt_ts_ctx_locktime;
  int __scrypt_ts_ctx_sequence;
  bytes __scrypt_ts_ctx_scriptcode;
  int __scrypt_ts_ctx_value;
  constructor(bytes campaignId, PubKey creator, PubKey arbiter, PubKey donor, int pledged, int[4] cumulativeBps, int refundAfter) {
    this.campaignId = campaignId;
    this.creator = creator;
    this.arbiter = arbiter;
    this.donor = donor;
    this.pledged = pledged;
    this.cumulativeBps = cumulativeBps;
    this.refundAfter = refundAfter;
  }
  public function release(Sig creatorSig, Sig arbiterSig, SigHashPreimage __scrypt_ts_txPreimage) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'c3')));
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_locktime = SigHash.nLocktime(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_sequence = SigHash.nSequence(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_scriptcode = SigHash.scriptCode(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    int value = this.__scrypt_ts_ctx_value;
    int current = this.pledged;
    bool found = false;
    int next = 0;
    loop (4) : i {
        int after = this.pledged - (this.pledged * this.cumulativeBps[i]) / 10000;
        if(!found && value == current && after < current) {
          found = true;
          next = after;
        }
        current = after;
      }
    require(found && (next == 0 || hash256(Utils.buildOutput(this.__scrypt_ts_ctx_scriptcode, next)) == this.__scrypt_ts_ctx_hashoutputs));
    require(checkSig(creatorSig, this.creator));
    require(checkSig(arbiterSig, this.arbiter));
  }
  public function refund(Sig donorSig, SigHashPreimage __scrypt_ts_txPreimage) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'41')));
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_locktime = SigHash.nLocktime(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_sequence = SigHash.nSequence(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_scriptcode = SigHash.scriptCode(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    require(this.timeLock(this.refundAfter));
    require(checkSig(donorSig, this.donor));
  }
  public function refundFailed(Sig donorSig, Sig arbiterSig) {
    require(checkSig(donorSig, this.donor));
    require(checkSig(arbiterSig, this.arbiter));
  }
  function timeLock(int locktime): bool {  bool res = true;  res = this.__scrypt_ts_ctx_sequence < 0xffffffff;  if (    locktime < 500000000  ) {    res = res && this.__scrypt_ts_ctx_locktime < 500000000;  }  return res && this.__scrypt_ts_ctx_locktime >= locktime;}
}