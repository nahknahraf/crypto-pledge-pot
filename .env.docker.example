# Copy to .env.docker (git-ignored), then: docker compose --env-file .env.docker up -d --build

# Public address. On a server with a domain pointing at it:
DOMAIN=pledgepot.example.com
PUBLIC_URL=https://pledgepot.example.com
# Laptop with ngrok instead (profile "tunnel"): keep DOMAIN=localhost and set
#   PUBLIC_URL=https://your-name.ngrok-free.app
#   NGROK_DOMAIN=your-name.ngrok-free.app
#   NGROK_AUTHTOKEN=<from the ngrok dashboard>
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# Published ports. Rootless Docker/Podman can't bind below 1024: use e.g. 8080/8443 locally.
HTTP_PORT=80
HTTPS_PORT=443
# Plain-HTTP entrance for an ngrok you run yourself: `ngrok http <TUNNEL_PORT>` (never port 80)
TUNNEL_PORT=8081

NETWORK=main
WATCH_S=300

# Keys: leave empty to generate them once inside each service's volume (back the volumes up!),
# or set them to move an existing setup (e.g. the arbiter key that legacy campaigns use).
CRYPTOPLEDGEPOT_ARBITER_KEY=
AGENT_ROOT_KEY=
DATA_PROVIDER_KEY=

# Agent
ANTHROPIC_API_KEY=
# Campaign terms come from one spending plan: READINGS × PRICE_CAP + FEE_ALLOWANCE per milestone, 3 milestones.
AGENT_READINGS=5
AGENT_PRICE_CAP=50
AGENT_FEE_ALLOWANCE=150
AGENT_FEE_RESERVE=3000
# Who runs the agent and answers for it (shown in its campaign terms)
AGENT_OPERATOR=
DATA_PRICE_SATS=50
